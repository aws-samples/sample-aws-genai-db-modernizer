      "optimizations": [
        {
          "category": "index",
          "target": "wp_postmeta, wp_woocommerce_order_itemmeta",
          "recommendation": "Add composite (post_id, meta_key) and (order_item_id, meta_key) indexes.",
          "rationale": "Hot lookups filter on both columns (about 14.5 and 1.9 calls/s); the single-column indexes examine 10-35 rows per call."
        },
        {
          "category": "index",
          "target": "wp_posts",
          "recommendation": "Reorder type_status_date to (post_type, post_status, post_date, ID).",
          "rationale": "The draft index leads with the primary key, so it cannot serve the post_type/post_status filters with post_date ordering used by the listing queries."
        },
        {
          "category": "read_replica",
          "target": "Aurora cluster",
          "recommendation": "Route read-only traffic (meta fetches, term joins, WooCommerce analytics reports) to Aurora Replicas via the reader endpoint.",
          "rationale": "Reads dominate (about 33 read QPS on wp_postmeta vs 4 write QPS), and the analytics queries scan 80k-370k rows."
        },
        {
          "category": "other",
          "target": "Connection/cache layer",
          "recommendation": "Keep wp_options autoload reads behind a WordPress object cache (ElastiCache) rather than moving the table.",
          "rationale": "wp_options is a hot key-value lookup but WordPress core expects it in the relational database; a cache gives the latency benefit without code changes."
        },
        {
          "category": "io_optimized",
          "target": "Aurora MySQL cluster",
          "recommendation": "Switch to the I/O-Optimized storage configuration.",
          "rationale": "I/O charges exceed 25% of the instance cost at this read/write volume."
        },
        {
          "category": "partitioning",
          "target": "wp_actionscheduler_logs",
          "recommendation": "Partition by month on the log_date column.",
          "rationale": "The table is append-only and queries filter on a recent date range."
        }
      ],
      "app_layer_notes": [
        {
          "feature": "zero_date_defaults",
          "source_object": "DATETIME columns with DEFAULT '0000-00-00 00:00:00' (wp_posts, wp_comments, wp_users, wp_actionscheduler_*, others)",
          "recommendation": "Aurora MySQL 3 (MySQL 8.0) runs with NO_ZERO_DATE in strict mode by default. Use a custom parameter group that matches the source sql_mode (as WordPress itself relies on it), or migrate zero dates to NULL during load."
        }
