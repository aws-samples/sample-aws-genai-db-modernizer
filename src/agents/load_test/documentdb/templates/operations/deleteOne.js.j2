// {{ query_id }}.js — deleteOne: {{ description }}
// Note: deletes target NEWLY-INSERTED keys (above seeded range) to avoid
// reducing the seeded data set during the test. Pre-inserts a doc, then
// deletes it.

import { runOperation } from '../helpers/client.js';
import { generateNewDocument } from '../helpers/key-generator.js';
import { createPatternMetrics } from '../helpers/metrics.js';

const metrics = createPatternMetrics('{{ query_id }}');
const COLLECTION = '{{ collection_name }}';
const KEY_COUNT = {{ primary_key_count }};

export default function () {
  const doc = generateNewDocument(KEY_COUNT);
  // Insert first so delete has a target — exercises both ops; only delete is timed
  runOperation(COLLECTION, 'insertOne', { document: doc });

  const start = Date.now();
  try {
    runOperation(COLLECTION, 'deleteOne', {
      filter: { primary_id: doc.primary_id },
    });
    metrics.latency.add(Date.now() - start);
    metrics.requests.add(1);
  } catch (err) {
    metrics.errors.add(1);
  }
}
