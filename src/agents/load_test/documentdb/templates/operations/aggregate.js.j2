// {{ query_id }}.js — aggregate: {{ description }}
// Minimal pipeline using only DocumentDB-compatible stages.
// Window functions, graph traversal, and faceted analytics are
// intentionally avoided (see ADR §45 for the compatibility matrix).

import { runOperation } from '../helpers/client.js';
import { generateExistingKey } from '../helpers/key-generator.js';
import { createPatternMetrics } from '../helpers/metrics.js';

const metrics = createPatternMetrics('{{ query_id }}');
const COLLECTION = '{{ collection_name }}';
const KEY_COUNT = {{ primary_key_count }};

export default function () {
  const startKey = generateExistingKey(KEY_COUNT);

  const start = Date.now();
  try {
    runOperation(COLLECTION, 'aggregate', {
      pipeline: [
        { $match: { primary_id: { $gte: startKey } } },
        { $limit: 100 },
        { $group: { _id: null, count: { $sum: 1 } } },
      ],
    });
    metrics.latency.add(Date.now() - start);
    metrics.requests.add(1);
  } catch (err) {
    metrics.errors.add(1);
  }
}
