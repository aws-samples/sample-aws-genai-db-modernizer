# Database Modernizer Assessment - Deployment Configuration
# Copy this file to .env and edit with your values:
#   cp .env.example .env

# Project naming (used for stack names and resource prefixes)
PROJECT_NAME=modernizer
ENV=dev

# AWS region for all resources
AWS_REGION=us-east-1

# Domain configuration (required for HTTPS + Cognito auth)
# You need a domain you own. The DNS stack creates a subdomain hosted zone.
# Example: PARENT_DOMAIN=mycompany.com, SUBDOMAIN=modernizer
#   → deploys to modernizer.mycompany.com
PARENT_DOMAIN=example.com
SUBDOMAIN=modernizer

# ECS task count per service (1 is fine for dev/testing)
DESIRED_COUNT=1
