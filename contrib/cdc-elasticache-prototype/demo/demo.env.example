# Copy to demo.env and fill in (demo.env is git-ignored). Only needed if this
# host cannot read CloudFormation/Secrets Manager. Get values from the stack
# outputs: cdc-cache-demo-source/target/broker and the source's RDS-managed secret.
# The DB user and password are read from the source DB secret at run time.
SRC='<source-cluster-writer-endpoint>'
TGT='<target-configuration-endpoint>'
BRK='<broker-primary-endpoint>'
SECRET_ARN='<source-db-secret-arn>'
DB='Inventory'
