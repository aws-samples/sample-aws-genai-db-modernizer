<mxfile host="app.diagrams.net" agent="CDC-cache">
  <diagram id="cdc-cache-aws-arch" name="CDC-cache AWS Architecture">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" vertex="1" style="text;html=1;fontSize=20;fontStyle=1;align=center;fontColor=#232F3E;" value="CDC-cache — AWS Reference Architecture (CDC: RDBMS → ElastiCache for Valkey)">
          <mxGeometry x="360" y="12" width="900" height="30" as="geometry" />
        </mxCell>

        <!-- ===================== BOUNDARIES ===================== -->
        <mxCell id="cloud" parent="1" vertex="1" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" value="AWS Cloud">
