        <mxCell id="e3" parent="1" source="brokerp" target="sinka" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#232F3E;" value="XREADGROUP · 6379">
