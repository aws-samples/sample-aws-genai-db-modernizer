        <mxCell id="brokerp" parent="1" vertex="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elasticache;" value="Broker — ElastiCache Valkey&#10;t4g.small · cluster-mode OFF&#10;primary · stream+offsets+DLQ">
          <mxGeometry x="620" y="360" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sinka" parent="1" vertex="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" value="Go Sink (Fargate)&#10;1 vCPU / 2 GB · task">
          <mxGeometry x="850" y="360" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="targetp" parent="1" vertex="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elasticache;" value="Target — ElastiCache Valkey&#10;m6g.large · cluster-mode ON · TLS&#10;shard primaries">
          <mxGeometry x="1080" y="360" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- ===================== AZ-b: replicas + sink ===================== -->
        <mxCell id="brokerr" parent="1" vertex="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elasticache;" value="Broker replica&#10;(auto-failover)">
          <mxGeometry x="620" y="560" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sinkb" parent="1" vertex="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" value="Go Sink task&#10;(same consumer group)">
