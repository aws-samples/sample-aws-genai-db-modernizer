        <!-- footnote -->
        <mxCell id="note" parent="1" vertex="1" style="text;html=1;fontSize=10;align=left;fontColor=#5a666c;" value="Security groups (least-privilege): task SG → Aurora:3306, Broker:6379, Target:6379 · App → Target:6379.  In transit: Debezium↔Broker plaintext (private, SG-only); Sink↔Target &amp; App↔Target TLS.  At-rest encryption on Aurora + Target.">
