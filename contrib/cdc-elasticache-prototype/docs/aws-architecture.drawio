        <!-- ===================== AZ-a: primary data path ===================== -->
        <mxCell id="aurora" parent="1" vertex="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;" value="Aurora MySQL&#10;Serverless v2 (writer)&#10;0.5–8 ACU · binlog=ROW">
