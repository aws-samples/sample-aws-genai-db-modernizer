        </mxCell>
        <mxCell id="azb" parent="1" vertex="1" style="rounded=0;dashed=1;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=12;fontColor=#00A4A6;fontSize=11;html=1;" value="Availability Zone b">
