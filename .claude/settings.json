{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python -I \"$CLAUDE_PROJECT_DIR/scripts/hooks/block_commit_bypass.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "uv run --no-project python -I \"$CLAUDE_PROJECT_DIR/scripts/hooks/block_credential_output.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "uv run --no-project python -I \"$CLAUDE_PROJECT_DIR/scripts/hooks/block_fork_pr_push.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python -I \"$CLAUDE_PROJECT_DIR/scripts/hooks/block_baseline_edit.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "uv run --no-project python -I \"$CLAUDE_PROJECT_DIR/scripts/hooks/block_contract_version_edit.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python -I \"$CLAUDE_PROJECT_DIR/scripts/hooks/require_gate_shown.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python -I \"$CLAUDE_PROJECT_DIR/scripts/hooks/remind_llm_run.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
